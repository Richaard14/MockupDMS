<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMSApp.Views.MyDocumentsPage"
             Title="My Documents"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="250, *">

        <!-- ============================================== -->
        <!-- SISI KIRI: SIDEBAR -->
        <!-- ============================================== -->
        <Grid Grid.Column="0" BackgroundColor="#0F172A" RowDefinitions="Auto, *, Auto" Padding="15,20,15,20">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="10,0,0,30">
                <Frame BackgroundColor="#3B82F6" WidthRequest="45" HeightRequest="30" CornerRadius="6" Padding="0" HasShadow="False">
                    <Label Text="LOGO" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <Label Text="DMS" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Menu Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="5">
                <!-- Inactive Home -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Home" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- ACTIVE MENU: My Documents -->
                <Frame BackgroundColor="#3B82F6" CornerRadius="8" Padding="15,12" HasShadow="False" BorderColor="Transparent">
                    <HorizontalStackLayout Spacing="15">
                        <Label Text="My Documents" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Inactive Menus -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateDocumentTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Create Document" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDocumentLibraryTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Document Library" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackingTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Tracking &amp; Trace" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <Label Text="Archive" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <Label Text="Settings" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- User Profile Bottom -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Padding="10">
                <Frame Grid.Column="0" WidthRequest="35" HeightRequest="35" CornerRadius="17.5" Padding="0" HasShadow="False" BackgroundColor="#E2E8F0">
                    <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                    <Label Text="User" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    <Label Text="Document Control" TextColor="#94A3B8" FontSize="11" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="⋮" TextColor="#94A3B8" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- SISI KANAN: MAIN CONTENT (MY DOCUMENTS) -->
        <!-- ============================================== -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="30" Spacing="25">

                <!-- Header: Search & Icons -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="50">
                    <Frame Grid.Column="0" CornerRadius="25" BackgroundColor="White" BorderColor="#E2E8F0" HasShadow="False" Padding="15,0" HorizontalOptions="Start" WidthRequest="400">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🔍" TextColor="#94A3B8" VerticalOptions="Center" />
                            <Entry Placeholder="Search in my documents..." WidthRequest="330" BackgroundColor="Transparent" TextColor="#1E293B" />
                        </HorizontalStackLayout>
                    </Frame>
                    <HorizontalStackLayout Grid.Column="1" Spacing="20" VerticalOptions="Center">
                        <Label Text="🔔" FontSize="20" TextColor="#64748B" VerticalOptions="Center" />
                        <Frame WidthRequest="35" HeightRequest="35" CornerRadius="17.5" Padding="0" HasShadow="False" BackgroundColor="#E2E8F0">
                            <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Page Title & Create Button -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="My Documents" FontSize="24" FontAttributes="Bold" TextColor="#1E293B" />
                        <Label Text="View and manage documents you have created or uploaded." FontSize="14" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="+ Create Document" Clicked="OnCreateDocumentClicked" BackgroundColor="#0D6EFD" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="40" Padding="15,0" VerticalOptions="Center" />
                </Grid>

                <!-- Filter / Tabs -->
                <HorizontalStackLayout Spacing="20">
                    <Label Text="All Documents (2)" FontSize="14" TextColor="#0D6EFD" FontAttributes="Bold" />
                    <Label Text="Drafts (0)" FontSize="14" TextColor="#64748B" />
                    <Label Text="Pending (1)" FontSize="14" TextColor="#64748B" />
                    <Label Text="Approved (1)" FontSize="14" TextColor="#64748B" />
                </HorizontalStackLayout>

                <!-- Documents List Table -->
                <Frame BackgroundColor="White" CornerRadius="10" HasShadow="True" BorderColor="Transparent" Padding="0">
                    <VerticalStackLayout>

                        <!-- Table Header -->
                        <Grid ColumnDefinitions="3*, 1.5*, 1.5*, 1.5*, Auto" Padding="20,15" BackgroundColor="#F8FAFC">
                            <Label Grid.Column="0" Text="Document Title" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="Category" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold"/>
                            <Label Grid.Column="2" Text="Status" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold"/>
                            <Label Grid.Column="3" Text="Last Updated" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold"/>
                            <Label Grid.Column="4" Text="Action" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold" Margin="0,0,10,0"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#E2E8F0" />

                        <!-- Data Row 1: Pending Approval -->
                        <Grid ColumnDefinitions="3*, 1.5*, 1.5*, 1.5*, Auto" Padding="20,15" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                                <Label Text="Contoh dokumen 1" FontSize="14" TextColor="#1E293B" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="HR" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                            <Frame Grid.Column="2" BackgroundColor="#FEF3C7" CornerRadius="12" Padding="10,4" HasShadow="False" HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="• Pending Approval" FontSize="11" TextColor="#D97706" FontAttributes="Bold" />
                            </Frame>
                            <Label Grid.Column="3" Text="Oct 14, 2026" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                            <Label Grid.Column="4" Text="⋮" FontSize="20" TextColor="#94A3B8" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Data Row 2: Approved -->
                        <Grid ColumnDefinitions="3*, 1.5*, 1.5*, 1.5*, Auto" Padding="20,15" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                                <Label Text="Contoh dokumen 2" FontSize="14" TextColor="#1E293B" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Finance" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                            <Frame Grid.Column="2" BackgroundColor="#D1FAE5" CornerRadius="12" Padding="10,4" HasShadow="False" HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="• Approved" FontSize="11" TextColor="#059669" FontAttributes="Bold" />
                            </Frame>
                            <Label Grid.Column="3" Text="Oct 10, 2026" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                            <Label Grid.Column="4" Text="⋮" FontSize="20" TextColor="#94A3B8" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>  
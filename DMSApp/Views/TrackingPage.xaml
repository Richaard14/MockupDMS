<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMSApp.Views.TrackingPage"
             Title="Tracking &amp; Trace"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="250, *">

        <!-- ============================================== -->
        <!-- SISI KIRI: SIDEBAR -->
        <!-- ============================================== -->
        <Grid Grid.Column="0" BackgroundColor="#0F172A" RowDefinitions="Auto, *, Auto" Padding="15,20,15,20">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="10,0,0,30">
                <Border BackgroundColor="#3B82F6" WidthRequest="45" HeightRequest="30" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                    <Label Text="LOGO" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Text="DMS" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Menu Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="5">
                <!-- Inactive Home -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Home" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Inactive My Documents -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMyDocumentsTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="My Documents" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Inactive Create Document -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateDocumentTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Create Document" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Inactive Document Library -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDocumentLibraryTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Document Library" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- ACTIVE MENU: Tracking & Trace -->
                <Border BackgroundColor="#3B82F6" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="15,12">
                    <HorizontalStackLayout Spacing="15">
                        <Label Text="Tracking &amp; Trace" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Inactive Menus -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <Label Text="Archive" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <Label Text="Settings" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- User Profile Bottom -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Padding="10">
                <Border Grid.Column="0" WidthRequest="35" HeightRequest="35" StrokeShape="RoundRectangle 17.5" StrokeThickness="0" BackgroundColor="#E2E8F0">
                    <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                    <Label Text="User" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    <Label Text="Document Control" TextColor="#94A3B8" FontSize="11" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="⋮" TextColor="#94A3B8" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- SISI KANAN: MAIN CONTENT (TRACKING & TRACE) -->
        <!-- ============================================== -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="30" Spacing="25">
                
                <!-- Header Top Bar: Search & Profile Icons -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="50">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 25" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="15,0" HorizontalOptions="Start" WidthRequest="400">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🔍" TextColor="#94A3B8" VerticalOptions="Center" />
                            <Entry Placeholder="Search..." WidthRequest="330" BackgroundColor="Transparent" TextColor="#1E293B" />
                        </HorizontalStackLayout>
                    </Border>
                    <HorizontalStackLayout Grid.Column="1" Spacing="20" VerticalOptions="Center">
                        <Label Text="🔔" FontSize="20" TextColor="#EAB308" VerticalOptions="Center" />
                        <Border WidthRequest="35" HeightRequest="35" StrokeShape="RoundRectangle 17.5" StrokeThickness="0" BackgroundColor="#E2E8F0">
                            <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Document Header Row -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                        <Border BackgroundColor="#EFF6FF" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                        </Border>
                        <Label Text="Contoh dokumen 1" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center" />
                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4" VerticalOptions="Center">
                            <Label Text="DOC-2025-0001" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Overall Status Badge -->
                    <Border Grid.Column="1" BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="14,6" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="In Approval" FontSize="12" TextColor="#059669" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Main Section Layout (Left Timeline + Right Summary Cards) -->
                <Grid ColumnDefinitions="*, 340" ColumnSpacing="25">
                    
                    <!-- ============================================== -->
                    <!-- SISI KIRI: WORKFLOW TIMELINE TRACE -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" StrokeThickness="1" Padding="30">
                        <VerticalStackLayout Spacing="0">
                            
                            <!-- Step 1: Created -->
                            <Grid ColumnDefinitions="40, *" RowDefinitions="Auto, Auto">
                                <!-- Node Circle -->
                                <Border Grid.Column="0" Grid.Row="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" BackgroundColor="#0D6EFD" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Start">
                                    <Label Text="1" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <!-- Connecting Line -->
                                <BoxView Grid.Column="0" Grid.Row="1" WidthRequest="2" Color="#3B82F6" HorizontalOptions="Center" VerticalOptions="Fill" Margin="0,0,12,0"/>
                                
                                <!-- Step Details -->
                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Spacing="4" Padding="0,0,0,30">
                                    <Label Text="Created" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" />
                                    <Label Text="10 Jun 2025, 10:24" FontSize="12" TextColor="#94A3B8" />
                                    <Label Text="by User" FontSize="13" TextColor="#64748B" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Step 2: Approval 1 - HR Manager -->
                            <Grid ColumnDefinitions="40, *" RowDefinitions="Auto, Auto">
                                <!-- Node Circle -->
                                <Border Grid.Column="0" Grid.Row="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" BackgroundColor="#10B981" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Start">
                                    <Label Text="✓" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <!-- Connecting Line -->
                                <BoxView Grid.Column="0" Grid.Row="1" WidthRequest="2" Color="#CBD5E1" HorizontalOptions="Center" VerticalOptions="Fill" Margin="0,0,12,0"/>
                                
                                <!-- Step Details -->
                                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" ColumnDefinitions="*, Auto" Padding="0,0,0,30">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Approval 1 - HR Manager" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" BackgroundColor="#E2E8F0" StrokeThickness="0">
                                                <Label Text="👤" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Label Text="Udin" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <Label Text="10 Jun 2025, 11:20" FontSize="12" TextColor="#94A3B8" Margin="0,2,0,0"/>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1" BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" VerticalOptions="Start">
                                        <Label Text="Approved" FontSize="11" TextColor="#16A34A" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Step 3: Approval 2 - Operational Manager (Active) -->
                            <Grid ColumnDefinitions="40, *" RowDefinitions="Auto, Auto">
                                <!-- Node Circle -->
                                <Border Grid.Column="0" Grid.Row="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" BackgroundColor="#3B82F6" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Start">
                                    <Label Text="3" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <!-- Connecting Line -->
                                <BoxView Grid.Column="0" Grid.Row="1" WidthRequest="2" Color="#CBD5E1" HorizontalOptions="Center" VerticalOptions="Fill" Margin="0,0,12,0"/>
                                
                                <!-- Step Details -->
                                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" ColumnDefinitions="*, Auto" Padding="0,0,0,30">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Approval 2 - Operational Manager" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" BackgroundColor="#E2E8F0" StrokeThickness="0">
                                                <Label Text="👤" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Label Text="Siti" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Label Text="⏱️" FontSize="12" VerticalOptions="Center"/>
                                            <Label Text="Waiting for approval" FontSize="12" TextColor="#94A3B8" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" VerticalOptions="Start">
                                        <Label Text="Pending" FontSize="11" TextColor="#D97706" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Step 4: Final Document -->
                            <Grid ColumnDefinitions="40, *" RowDefinitions="Auto, Auto">
                                <!-- Node Circle -->
                                <Border Grid.Column="0" Grid.Row="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" HorizontalOptions="Start" VerticalOptions="Start">
                                    <Label Text="4" TextColor="#94A3B8" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <!-- Connecting Line -->
                                <BoxView Grid.Column="0" Grid.Row="1" WidthRequest="2" Color="#CBD5E1" HorizontalOptions="Center" VerticalOptions="Fill" Margin="0,0,12,0"/>
                                
                                <!-- Step Details -->
                                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" ColumnDefinitions="*, Auto" Padding="0,0,0,30">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Final Document" FontSize="15" FontAttributes="Bold" TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" VerticalOptions="Start">
                                        <Label Text="Pending" FontSize="11" TextColor="#D97706" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Step 5: Completed -->
                            <Grid ColumnDefinitions="40, *">
                                <!-- Node Circle -->
                                <Border Grid.Column="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" HorizontalOptions="Start" VerticalOptions="Start">
                                    <Label Text="5" TextColor="#94A3B8" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                
                                <!-- Step Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Completed" FontSize="15" FontAttributes="Bold" TextColor="#64748B" />
                                    <Label Text="Not yet completed" FontSize="12" TextColor="#94A3B8" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- ============================================== -->
                    <!-- SISI KANAN: SUMMARY CARDS -->
                    <!-- ============================================== -->
                    <VerticalStackLayout Grid.Column="1" Spacing="20">
                        
                        <!-- Card 1: Current Step -->
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" StrokeThickness="1" Padding="25">
                            <VerticalStackLayout Spacing="20">
                                <Label Text="Current Step" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" />
                                
                                <HorizontalStackLayout Spacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#DBEAFE" StrokeThickness="0">
                                        <Label Text="👤" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="Approval 2 - Operational Manager" FontSize="13" FontAttributes="Bold" TextColor="#1E293B" />
                                        <Label Text="Siti" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <Button Text="View Details" BackgroundColor="#0D6EFD" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 2: Document Progress -->
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" StrokeThickness="1" Padding="25">
                            <VerticalStackLayout Spacing="20">
                                <Label Text="Document Progress" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" />

                                <!-- Progress Bar Layout -->
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                                    <!-- Visual Progress Bar -->
                                    <Grid Grid.Row="0" Grid.Column="0" HeightRequest="10" VerticalOptions="Center">
                                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 5" StrokeThickness="0"/>
                                        <Border BackgroundColor="#0D6EFD" StrokeShape="RoundRectangle 5" StrokeThickness="0" HorizontalOptions="Start" WidthRequest="120"/>
                                    </Grid>
                                    
                                    <!-- Percentage -->
                                    <Label Grid.Row="0" Grid.Column="1" Text="50%" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F1F5F9" />

                                <!-- Estimated Completion -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Estimated Completion" FontSize="12" TextColor="#94A3B8" />
                                    <Label Text="2 days" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
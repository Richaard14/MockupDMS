<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMSApp.Views.DocumentLibraryPage"
             Title="Document Library"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="250, *">

        <!-- ============================================== -->
        <!-- SISI KIRI: SIDEBAR -->
        <!-- ============================================== -->
        <Grid Grid.Column="0" BackgroundColor="#0F172A" RowDefinitions="Auto, *, Auto" Padding="15,20,15,20">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="10,0,0,30">
                <Frame BackgroundColor="#3B82F6" WidthRequest="45" HeightRequest="30" CornerRadius="6" Padding="0" HasShadow="False">
                    <Label Text="LOGO" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <Label Text="DMS" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Menu Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="5">
                <!-- Inactive Home -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Home" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Inactive My Documents -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMyDocumentsTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="My Documents" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Inactive Create Document -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateDocumentTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Create Document" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- ACTIVE MENU: Document Library -->
                <Frame BackgroundColor="#3B82F6" CornerRadius="8" Padding="15,12" HasShadow="False" BorderColor="Transparent">
                    <HorizontalStackLayout Spacing="15">
                        <Label Text="Document Library" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Inactive Menus -->
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackingTapped"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="Tracking &amp; Trace" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <Label Text="Archive" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" Padding="15,12">
                    <Label Text="Settings" TextColor="#94A3B8" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- User Profile Bottom -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Padding="10">
                <Frame Grid.Column="0" WidthRequest="35" HeightRequest="35" CornerRadius="17.5" Padding="0" HasShadow="False" BackgroundColor="#E2E8F0">
                    <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                    <Label Text="User" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    <Label Text="Document Control" TextColor="#94A3B8" FontSize="11" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="⋮" TextColor="#94A3B8" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- SISI KANAN: MAIN CONTENT (DOCUMENT LIBRARY) -->
        <!-- ============================================== -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="30" Spacing="20">

                <!-- Header Top Bar: Search & Profile Icons -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="50">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 25" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="15,0" HorizontalOptions="Start" WidthRequest="400">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🔍" TextColor="#94A3B8" VerticalOptions="Center" />
                            <Entry Placeholder="Search..." WidthRequest="330" BackgroundColor="Transparent" TextColor="#1E293B" />
                        </HorizontalStackLayout>
                    </Border>
                    <HorizontalStackLayout Grid.Column="1" Spacing="20" VerticalOptions="Center">
                        <Label Text="🔔" FontSize="20" TextColor="#EAB308" VerticalOptions="Center" />
                        <Border WidthRequest="35" HeightRequest="35" StrokeShape="RoundRectangle 17.5" StrokeThickness="0" BackgroundColor="#E2E8F0">
                            <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Page Header Title -->
                <Label Text="Document Library" FontSize="22" FontAttributes="Bold" TextColor="#1E293B" Margin="0,5,0,0" />

                <!-- Search Title & Action Bar -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="15,0" HeightRequest="45">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🔍" TextColor="#94A3B8" VerticalOptions="Center" />
                            <Entry Placeholder="Search document title, number, or type..." BackgroundColor="Transparent" TextColor="#1E293B" HorizontalOptions="FillAndExpand" WidthRequest="500" />
                        </HorizontalStackLayout>
                    </Border>

                    <Button Grid.Column="1" Text="+ Create Document" Clicked="OnCreateDocumentClicked" BackgroundColor="#0D6EFD" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Padding="20,0" VerticalOptions="Center"/>
                </Grid>

                <!-- Two-Column Layout: Left Filters + Right Table -->
                <Grid ColumnDefinitions="220, *" ColumnSpacing="20" Margin="0,10,0,0">

                    <!-- SISI KIRI CONTENT: FILTERS & RECENTLY VIEWED -->
                    <VerticalStackLayout Grid.Column="0" Spacing="15">

                        <!-- Dropdown 1: All Departments -->
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="All Departments" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="˅" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Dropdown 2: All Document Types -->
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="All Document Types" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="˅" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Dropdown 3: All Status -->
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="All Status" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="˅" FontSize="12" TextColor="#94A3B8" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Recently Viewed List -->
                        <VerticalStackLayout Spacing="12" Margin="0,15,0,0">
                            <Label Text="Recently Viewed" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" />

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Contoh dokumen 1" FontSize="12" TextColor="#475569" LineBreakMode="TailTruncation" WidthRequest="180"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Contoh dokumen 2" FontSize="12" TextColor="#475569" LineBreakMode="TailTruncation" WidthRequest="180"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Contoh dokumen 3" FontSize="12" TextColor="#475569" LineBreakMode="TailTruncation" WidthRequest="180"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Contoh dokumen 4" FontSize="12" TextColor="#475569" LineBreakMode="TailTruncation" WidthRequest="180"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Contoh dokumen 5" FontSize="12" TextColor="#475569" LineBreakMode="TailTruncation" WidthRequest="180"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- SISI KANAN CONTENT: DOCUMENT TABLE -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="0">
                        <VerticalStackLayout>

                            <!-- Table Header -->
                            <Grid ColumnDefinitions="40, 2.5*, 1.8*, 1.2*, 1.2*, Auto" Padding="20,15" BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="No." FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="Document Title" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="Type" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="3" Text="Status" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="4" Text="Expiry Date" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="5" Text="Actions" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Row 1 -->
                            <Grid ColumnDefinitions="40, 2.5*, 1.8*, 1.2*, 1.2*, Auto" Padding="20,15" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="1" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Contoh dokumen 1" FontSize="13" TextColor="#1E293B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Label Text="Employment&#x0a;Contract" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Border Grid.Column="3" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start" VerticalOptions="Center">
                                    <Label Text="In Approval" FontSize="11" TextColor="#D97706" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="4" Text="31 Dec 2026" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="5" Text="⋮" FontSize="18" TextColor="#94A3B8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Row 2 -->
                            <Grid ColumnDefinitions="40, 2.5*, 1.8*, 1.2*, 1.2*, Auto" Padding="20,15" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="2" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Contoh dokumen 2" FontSize="13" TextColor="#1E293B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="NDA" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Border Grid.Column="3" BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start" VerticalOptions="Center">
                                    <Label Text="Active" FontSize="11" TextColor="#16A34A" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="4" Text="-" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="5" Text="⋮" FontSize="18" TextColor="#94A3B8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Row 3 -->
                            <Grid ColumnDefinitions="40, 2.5*, 1.8*, 1.2*, 1.2*, Auto" Padding="20,15" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="3" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Contoh dokumen 3" FontSize="13" TextColor="#1E293B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="Purchase Order" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Border Grid.Column="3" BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start" VerticalOptions="Center">
                                    <Label Text="Active" FontSize="11" TextColor="#16A34A" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="4" Text="15 Aug 2025" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="5" Text="⋮" FontSize="18" TextColor="#94A3B8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Row 4 -->
                            <Grid ColumnDefinitions="40, 2.5*, 1.8*, 1.2*, 1.2*, Auto" Padding="20,15" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="4" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="contoh dokumen 4" FontSize="13" TextColor="#1E293B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="Project Proposal" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Border Grid.Column="3" BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start" VerticalOptions="Center">
                                    <Label Text="Active" FontSize="11" TextColor="#16A34A" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="4" Text="20 Sep 2025" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="5" Text="⋮" FontSize="18" TextColor="#94A3B8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Row 5 -->
                            <Grid ColumnDefinitions="40, 2.5*, 1.8*, 1.2*, 1.2*, Auto" Padding="20,15" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="5" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Contoh dokumen 5" FontSize="13" TextColor="#1E293B" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="SOP" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Border Grid.Column="3" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start" VerticalOptions="Center">
                                    <Label Text="Archived" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="4" Text="-" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                                <Label Grid.Column="5" Text="⋮" FontSize="18" TextColor="#94A3B8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Table Pagination Footer -->
                            <Grid ColumnDefinitions="*, Auto" Padding="20,15" VerticalOptions="Center">
                                <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                    <Border StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" StrokeThickness="1" WidthRequest="32" HeightRequest="32" BackgroundColor="White">
                                        <Label Text="‹" FontSize="16" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="32" HeightRequest="32" BackgroundColor="#0D6EFD">
                                        <Label Text="1" FontSize="13" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" StrokeThickness="1" WidthRequest="32" HeightRequest="32" BackgroundColor="White">
                                        <Label Text="2" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" StrokeThickness="1" WidthRequest="32" HeightRequest="32" BackgroundColor="White">
                                        <Label Text="3" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" StrokeThickness="1" WidthRequest="32" HeightRequest="32" BackgroundColor="White">
                                        <Label Text="4" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" StrokeThickness="1" WidthRequest="32" HeightRequest="32" BackgroundColor="White">
                                        <Label Text="5" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" StrokeThickness="1" WidthRequest="32" HeightRequest="32" BackgroundColor="White">
                                        <Label Text="..." FontSize="13" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" StrokeThickness="1" WidthRequest="32" HeightRequest="32" BackgroundColor="White">
                                        <Label Text="›" FontSize="16" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </HorizontalStackLayout>

                                <Label Grid.Column="1" Text="Showing 1-5 of 243" FontSize="13" TextColor="#64748B" VerticalOptions="Center"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>